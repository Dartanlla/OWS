{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithExceptionDetails", "WithMachineName", "WithCorrelationId", "WithClientIp", "WithClientAgent" ],
    "Properties": {
      "Application": "OWSPublicApi"
    }
  },
  "OWSPublicAPIConfig": {
    "SecondsToWaitForServerSpinUp": 25,
    "SecondsToWaitInBetweenSpinUpPolling": 0.25,
    "SecondsToWaitBeforeFirstPollForSpinUp": 1
  },
  "OWSAPIPathConfig": {
    "InternalPublicApiURL": "http://host.docker.internal:44302/",
    "InternalInstanceManagementApiURL": "http://host.docker.internal:44328/",
    "InternalCharacterPersistenceApiURL": "http://host.docker.internal:44323/"
  },
  "OWSStorageConfig": {
    "OWSDBBackend": "postgres",
    "OWSDBConnectionString": "Server=host.docker.internal;Database=openworldserver;User Id=SA;Password=yourStrong(!)Password;ConnectRetryCount=0"
  },
  "UserSessionCacheOptions": {
    "ConnectionString": "localhost:6379",
    "Password": "YourValkeyPass",
    "Database": 0,
    "KeyPrefix": "user:session:"
  },

  "ExternalLoginProviderConfig": {

    "EpicOnlineServices": {
      "ClientId": "",
      "ClientSecret": "",
      "DeploymentId": "",
      "RedirectUri": ""
    }
  },

  "SteamConfig": {
    "WebApiHost": "https://api.steampowered.com",
    "WebApiKey": "",
    "AppId": "",
    "Identity": "samsarasaga"
  },

  "GameServersConfig": {
    "Servers": [
      {
        "Name": "Samsara",
        "Region": "NA-EAST",
        "Status": "online",
        "Population": "low",
        "PingHost": "http://87.99.150.89:44302/api/Servers/List"
      }
    ]
  }

}
