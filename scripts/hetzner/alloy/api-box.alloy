// Grafana Alloy on the OWS API box. Endpoints, users and the token come from /etc/default/alloy.
// Job names match the Grafana Cloud Linux, Docker and PostgreSQL integrations, so their dashboards work.

loki.write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL") + "/loki/api/v1/push"

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }

  external_labels = {
    host = sys.env("ALLOY_INSTANCE"),
  }
}

prometheus.remote_write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

prometheus.relabel "instance" {
  rule {
    target_label = "instance"
    replacement  = sys.env("ALLOY_INSTANCE")
  }

  forward_to = [prometheus.remote_write.cloud.receiver]
}

// Container logs, labelled by compose service.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.ows.receiver]
}

// OWS services write Serilog compact JSON, which omits "@l" on Information events.
loki.process "ows" {
  stage.match {
    selector = "{service=~\"ows.+\"}"

    stage.json {
      expressions = { level = "\"@l\"" }
    }

    stage.template {
      source   = "level"
      template = "{{ if .Value }}{{ .Value }}{{ else }}Information{{ end }}"
    }

    stage.labels {
      values = { level = "" }
    }
  }

  // Grafana Cloud rejects entries older than 7 days, e.g. when Alloy first reads a container's history.
  stage.drop {
    older_than          = "144h"
    drop_counter_reason = "too_old"
  }

  forward_to = [loki.write.cloud.receiver]
}

// SSH logins and sudo use, from the systemd journal: who reached the box and what ran as root.
loki.source.journal "auth" {
  max_age       = "12h"
  labels        = { job = "auth" }
  relabel_rules = loki.relabel.auth.rules
  forward_to    = [loki.process.auth.receiver]
}

loki.relabel "auth" {
  forward_to = []

  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label  = "identifier"
  }
}

// sshd also logs every scanner's failed attempt; keep accepted logins and session opens and closes.
loki.process "auth" {
  stage.match {
    selector            = "{job=\"auth\", identifier!~\"sshd|sudo\"}"
    action              = "drop"
    drop_counter_reason = "not_auth"
  }

  stage.match {
    selector            = "{job=\"auth\", identifier=\"sshd\"} !~ \"Accepted |session opened|session closed\""
    action              = "drop"
    drop_counter_reason = "ssh_noise"
  }

  forward_to = [loki.write.cloud.receiver]
}

// Metrics. Each exporter sets its own job label, which scrape job_name does not override.

prometheus.exporter.unix "host" { }

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "host" {
  targets    = discovery.relabel.host.output
  forward_to = [prometheus.relabel.instance.receiver]
}

prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "5m"
}

discovery.relabel "containers_metrics" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    target_label = "job"
    replacement  = "integrations/docker"
  }
}

prometheus.scrape "containers" {
  targets    = discovery.relabel.containers_metrics.output
  forward_to = [prometheus.relabel.instance.receiver]
}

prometheus.exporter.postgres "db" {
  data_source_names = [sys.env("POSTGRES_MONITOR_DSN")]
}

discovery.relabel "db" {
  targets = prometheus.exporter.postgres.db.targets

  rule {
    target_label = "job"
    replacement  = "integrations/postgres_exporter"
  }
}

prometheus.scrape "db" {
  targets    = discovery.relabel.db.output
  forward_to = [prometheus.relabel.instance.receiver]
}

// Zone and player load (ows_zone_*, ows_online_*) from the game database, for the "OWS load" dashboard.
prometheus.exporter.postgres "ows_load" {
  data_source_names          = [string.replace(sys.env("POSTGRES_MONITOR_DSN"), "/postgres?", "/openworldserver?")]
  custom_queries_config_path = "/etc/alloy/ows-load-queries.yaml"
  disable_default_metrics    = true
  disable_settings_metrics   = true
}

discovery.relabel "ows_load" {
  targets = prometheus.exporter.postgres.ows_load.targets

  rule {
    target_label = "job"
    replacement  = "ows_load"
  }
}

prometheus.scrape "ows_load" {
  targets         = discovery.relabel.ows_load.output
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.instance.receiver]
}

// Each app service's /health (OWSData/Health/OWSHealthChecks.cs); the Grafana alert reads probe_success.
prometheus.exporter.blackbox "ows_health" {
  config = "{ modules: { http_2xx: { prober: http, timeout: 5s } } }"

  target {
    name    = "owspublicapi"
    address = "http://127.0.0.1:44302/health"
    module  = "http_2xx"
    labels  = { "service" = "owspublicapi" }
  }

  target {
    name    = "owsinstancemanagement"
    address = "http://127.0.0.1:44328/health"
    module  = "http_2xx"
    labels  = { "service" = "owsinstancemanagement" }
  }

  target {
    name    = "owscharacterpersistence"
    address = "http://127.0.0.1:44323/health"
    module  = "http_2xx"
    labels  = { "service" = "owscharacterpersistence" }
  }

  target {
    name    = "owsglobaldata"
    address = "http://127.0.0.1:44325/health"
    module  = "http_2xx"
    labels  = { "service" = "owsglobaldata" }
  }

  target {
    name    = "owsmanagement"
    address = "http://127.0.0.1:44410/health"
    module  = "http_2xx"
    labels  = { "service" = "owsmanagement" }
  }

  target {
    name    = "owsparty"
    address = "http://127.0.0.1:44306/health"
    module  = "http_2xx"
    labels  = { "service" = "owsparty" }
  }

  target {
    name    = "owschat"
    address = "http://127.0.0.1:44351/health"
    module  = "http_2xx"
    labels  = { "service" = "owschat" }
  }
}

prometheus.scrape "ows_health" {
  targets         = prometheus.exporter.blackbox.ows_health.targets
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.ows_health.receiver]
}

prometheus.relabel "ows_health" {
  rule {
    source_labels = ["__name__"]
    regex         = "probe_success|probe_duration_seconds|probe_http_status_code"
    action        = "keep"
  }

  forward_to = [prometheus.relabel.instance.receiver]
}
